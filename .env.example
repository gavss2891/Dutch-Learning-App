# ---------- Audio: Google Cloud Text-to-Speech ----------
# Restrict this key to the Cloud Text-to-Speech API only.
GOOGLE_TTS_KEY=
GOOGLE_TTS_VOICE=nl-NL-Wavenet-D

# ---------- Voice input: Google Cloud Speech-to-Text ----------
# Restrict this key to the Cloud Speech-to-Text API only.
GOOGLE_STT_KEY=

# ---------- Corrections: Gemini ----------
# "vertex"   = Vertex AI express mode. Billed through Cloud Billing, so your
#              free trial credits apply. Uses your express-mode API key.
# "aistudio" = Gemini Developer API key from aistudio.google.com.
MODEL_PROVIDER=vertex

VERTEX_API_KEY=
# Only needed if MODEL_PROVIDER=aistudio
GEMINI_API_KEY=

MODEL_NAME=gemini-3.5-flash

# Reasoning tokens are the main cause of slow replies. 0 disables them.
# Leave blank to let the model decide (slower). Not all models allow 0.
THINKING_BUDGET=0

PORT=8787
